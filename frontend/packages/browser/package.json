{
  "name": "@almamesh/browser",
  "version": "0.0.1",
  "license": "MIT",
  "description": "In-browser local-first AlmaMesh engine: edge-proc signed-bundle sync + Pyodide chart compute, entirely on-device. Reuses @edgeproc/browser/engine (the edge-reco sync tier, vendored at packages/edgeproc-browser) as a workspace dependency.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parity": "node integration/parity.mjs",
    "test:parity-rectify": "node integration/rectification-precision.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@edgeproc/assay": "0.5.0-dev.3",
    "@edgeproc/avow": "0.4.1",
    "@edgeproc/browser": "workspace:*",
    "@hpcc-js/wasm-zstd": "^1.15.0",
    "@noble/ed25519": "^3.1.0",
    "pyodide": "^314.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
