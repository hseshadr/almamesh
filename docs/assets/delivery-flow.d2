# AlmaMesh delivery + compute flow: signed bundle -> OPFS -> Pyodide engine.
# Render: d2 docs/assets/delivery-flow.d2 docs/assets/delivery-flow.svg

direction: right

publisher: "Build time (publisher machine / CI)" {
  wheel: "almamesh wheel\n(unchanged Python engine)"
  assets: "de421.bsp + finals2000A.all\n+ pyodide/skyfield wheels"
  cli: "almamesh-bundle CLI\ned25519-sign, content-address"
  wheel -> cli
  assets -> cli
}

cdn: "Static hosting (Cloudflare Pages)" {
  bundle: "Signed bundle\n(manifest + chunks)"
  key: "/public.key\n(the pinned verify key)"
}

browser: "The user's browser tab (everything below is on-device)" {
  sync: "@almamesh/browser\nverify signature (fail-closed),\nsync chunks"
  opfs: "OPFS cache\n(Origin Private File System —\nprivate on-disk browser storage)"
  worker: "Web Worker" {
    pyodide: "Pyodide (Python-in-WASM)\nboots the UNCHANGED wheel"
    engine: "almamesh engine\nbyte-identical to CPython\n(golden parity fixtures)"
    pyodide -> engine
  }
  ui: "React PWA\ncharts, dasha, mesh, report"

  sync -> opfs: "store verified chunks"
  opfs -> worker.pyodide: "load wheels + ephemeris"
  worker.engine -> ui: "SiderealChart JSON\n(TS only reshapes, never computes)"
}

publisher.cli -> cdn.bundle: "publish"
cdn.bundle -> browser.sync: "one-way delivery\n(no data ever flows back)"
cdn.key -> browser.sync: "pin"
