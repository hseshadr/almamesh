# =============================================================================
# AlmaMesh Backend — Environment Configuration
# =============================================================================
# Copy to .env and adjust. Every key here maps to a field in
# src/almamesh/config.py (Settings). Unknown keys are ignored.
# NEVER commit a .env with real secrets.
#
# AlmaMesh is local-first: there is no server. The Python package is the
# deterministic chart engine plus the build-time bundle publisher, so the only
# backend config is the engine ephemeris. AI is configured in the app itself
# (Settings → AI in the browser), never via backend environment variables.
# =============================================================================

# --- App -----------------------------------------------------------------
APP_NAME=AlmaMesh

# --- Engine --------------------------------------------------------------
# Ephemeris the publisher ships + records in bundle provenance. Must match
# the engine default (calculations.DEFAULT_EPHEMERIS_FILE). de421.bsp (~16 MB)
# is the shippable browser payload.
EPHEMERIS_FILE=de421.bsp
